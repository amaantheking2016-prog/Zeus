VisualTab:CreateToggle({ Name="Ball Stats", CurrentValue=false, Flag="BS",
    Callback = function(on)
        State.BallStats = on
        if on then
            local gui = Instance.new("ScreenGui"); gui.Name = "ZeusBallStats"
            gui.ResetOnSpawn = false; gui.Parent = PlayerGui
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.25, 0, 0.05, 0)
            lbl.Position = UDim2.new(0.7, 0, 0.1, 0)
            lbl.TextSize = 22; lbl.BackgroundTransparency = 1
            lbl.TextColor3 = Color3.new(1,1,1); lbl.Font = Enum.Font.Fantasy
            lbl.TextStrokeTransparency = 0.3
            lbl.Text = "Waiting..."; lbl.Parent = gui
            State.BSGui = gui; State.BSLabel = lbl
            if Connections.BS then Connections.BS:Disconnect() end
            Connections.BS = RunService.Heartbeat:Connect(function()
                if not State.BallStats then return end
                local maxV = 0
                for _, b in ipairs(getBalls()) do
                    local z = b:FindFirstChild("zoomies")
                    if z then maxV = math.max(maxV, z.VectorVelocity.Magnitude) end
                end
                if maxV > 0 then
                    local flag = maxV >= 2200
                    lbl.Text = string.format("Ball: %.0f%s", maxV, flag and " (MAX)" or "")
                    lbl.TextColor3 = flag and Color3.new(1,0,0) or Color3.new(1,1,1)
                else
                    lbl.Text = "Waiting..."
                end
            end)
        else
            if Connections.BS then Connections.BS:Disconnect(); Connections.BS = nil end
            if State.BSGui then State.BSGui:Destroy(); State.BSGui = nil end
        end
    end })

