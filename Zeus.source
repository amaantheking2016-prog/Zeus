-- ═══ SKIN TAB ═══
SkinTab:CreateSection("Skin Changer")
local SkinState = { enabled=false, swordModule=nil, swordInfo=nil, origSword=nil, loopConn=nil }

local function getSwordModule()
    if SkinState.swordModule then return SkinState.swordModule end
    local okk, mod = pcall(function() return require(ReplicatedStorage.Shared.ReplicatedInstances.Swords) end)
    if okk and mod then SkinState.swordModule = mod end
    return SkinState.swordModule
end

local function getSwordInfo()
    if SkinState.swordInfo then return SkinState.swordInfo end
    pcall(function()
        for _, conn in ipairs(getconnections(ReplicatedStorage.Remotes.FireSwordInfo.OnClientEvent)) do
            if conn.Function and islclosure(conn.Function) then
                local ups = getupvalues(conn.Function)
                if #ups == 1 and type(ups[1]) == "table" then
                    SkinState.swordInfo = ups[1]; break
                end
            end
        end
    end)
    return SkinState.swordInfo
end

local function applySword()
    if not SkinState.enabled or not Player.Character then return end
    local mod = getSwordModule()
    if not mod then return end
    pcall(function() setupvalue(rawget(mod, "EquipSwordTo"), 3, false) end)
    pcall(function() mod:EquipSwordTo(Player.Character, State.SwordModel) end)
    local info = getSwordInfo()
    if info then pcall(function() info:SetSword(State.SwordModel) end) end
end

SkinTab:CreateToggle({ Name="Skin Changer", CurrentValue=false, Flag="SC",
    Callback = function(on)
        State.SkinChanger = on
        SkinState.enabled = on
        if on then
            SkinState.origSword = Player:GetAttribute("CurrentlyEquippedSword")
            applySword()
            if SkinState.loopConn then SkinState.loopConn:Disconnect() end
            SkinState.loopConn = RunService.Heartbeat:Connect(function()
                if not SkinState.enabled or not Player.Character then return end
                if State.SwordModel ~= "" and Player:GetAttribute("CurrentlyEquippedSword") ~= State.SwordModel then
                    applySword()
                end
            end)
        else
            if SkinState.loopConn then SkinState.loopConn:Disconnect(); SkinState.loopConn = nil end
            local mod = getSwordModule()
            if mod and SkinState.origSword then
                pcall(function() mod:EquipSwordTo(Player.Character, SkinState.origSword) end)
            end
        end
    end })

SkinTab:CreateInput({ Name="Sword Name", PlaceholderText="Enter sword name...",
    RemoveTextAfterFocusLost=false, Flag="SW_N",
    Callback = function(text) State.SwordModel = text; if SkinState.enabled then applySword() end end })

-- ═══ UNLOCK TAB ═══
UnlockTab:CreateSection("Unlock All")
UnlockTab:CreateButton({
    Name = "Unlock All Swords & Explosions",
    Callback = function()
        local shop = PlayerGui:FindFirstChild("Shop")
        if not shop then
            Rayfield:Notify({ Title="Unlock All", Content="Open the shop first!", Duration=3 })
            return
        end
        task.spawn(function()
            while task.wait(0.15) do
                local holder = shop:FindFirstChild("Holder")
                if not holder then continue end
                local pages = holder:FindFirstChild("Pages")
                for _, pg in ipairs({"Sword","Explosion"}) do
                    local page = pages and pages:FindFirstChild(pg)
                    if page then
                        local hdr = page:FindFirstChild("HeaderTitle")
                        if hdr then hdr.Visible = false end
                        for _, desc in ipairs(page:GetDescendants()) do
                            if desc.Name == "Lock" and desc:IsA("GuiObject") then
                                desc.Visible = false
                                local card = desc.Parent
                                if card and card:IsA("GuiObject") then
                                    card.LayoutOrder = 0
                                    if card.Parent and card.Parent.Name == "Unowned" then
                                        local owned = page:FindFirstChild("Owned", true)
                                        if owned then card.Parent = owned end
                                    end
                                end
                            end
                        end
                    end
                end
                if PlayerGui:FindFirstChild("Shop") ~= shop then break end
            end
        end)
        Rayfield:Notify({ Title="Unlock All", Content="Unlocking...", Duration=3 })
    end,
})

