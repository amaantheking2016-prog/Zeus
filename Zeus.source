MiscTab:CreateSection("Semi Immortal")
MiscTab:CreateToggle({ Name="Semi Immortal (Desync)", CurrentValue=false, Flag="SI",
    Callback = function(on)
        State.SemiImmortal = on
        if on then
            if Connections.SI then Connections.SI:Disconnect() end
            local orig = {}
            Connections.SI = RunService.Heartbeat:Connect(function()
                if not State.SemiImmortal then return end
                local c = Player.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                orig.cf = hrp.CFrame; orig.vel = hrp.AssemblyLinearVelocity
                local ang = tick() * 10
                hrp.CFrame = orig.cf * CFrame.new(math.cos(ang) * State.SemiRadius, State.SemiHeight, math.sin(ang) * State.SemiRadius)
                hrp.AssemblyLinearVelocity = Vector3.new(1, 1, 1)
                RunService.RenderStepped:Wait()
                hrp.CFrame = orig.cf
                hrp.AssemblyLinearVelocity = orig.vel
            end)
        elseif Connections.SI then
            Connections.SI:Disconnect(); Connections.SI = nil
        end
    end })

