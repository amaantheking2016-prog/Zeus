DetectionTab:CreateToggle({ Name="Infinity Detection", CurrentValue=false, Flag="D_Inf", Callback = function(v) State.DetectInfinity = v end })
DetectionTab:CreateToggle({ Name="Death Slash Detection", CurrentValue=false, Flag="D_DS", Callback = function(v) State.DetectDeathSlash = v end })
DetectionTab:CreateToggle({ Name="Time Hole Detection", CurrentValue=false, Flag="D_TH", Callback = function(v) State.DetectTimeHole = v end })
DetectionTab:CreateToggle({ Name="Slashes of Fury", CurrentValue=false, Flag="D_SoF", Callback = function(v) State.DetectSoF = v end })

DetectionTab:CreateToggle({ Name="Anti Phantom", CurrentValue=false, Flag="D_Phantom",
    Callback = function(v)
        State.DetectPhantom = v
        if v and Runtime then
            if Connections.Phantom then Connections.Phantom:Disconnect() end
            Connections.Phantom = Runtime.ChildAdded:Connect(function(c)
                if c.Name == "maxTransmission" or c.Name == "transmissionpart" then
                    local w = c:FindFirstChildWhichIsA("WeldConstraint")
                    if w and w.Part1 and Player.Character and w.Part1:IsDescendantOf(Player.Character) then
                        w:Destroy()
                    end
                end
            end)
        elseif Connections.Phantom then
            Connections.Phantom:Disconnect(); Connections.Phantom = nil
        end
    end })

DetectionTab:CreateSection("Player Detections")
DetectionTab:CreateToggle({ Name="Staff Detection", CurrentValue=false, Flag="D_Staff",
    Callback = function(v)
        State.DetectStaff = v
        if v then
            if Connections.Staff then Connections.Staff:Disconnect() end
            Connections.Staff = Players.PlayerAdded:Connect(function(p)
                pcall(function()
                    local role = tostring(p:GetRoleInGroup(1200769)):lower()
                    local isStaff = role ~= "guest" and role ~= "member" and role ~= ""
                    if not isStaff then
                        role = tostring(p:GetRoleInGroup(2868472)):lower()
                        isStaff = role ~= "guest" and role ~= "member" and role ~= ""
                    end
                    if isStaff then
                        Rayfield:Notify({ Title="Staff Detected", Content=p.DisplayName .. " (" .. role .. ")", Duration=8 })
                    end
                end)
            end)
        elseif Connections.Staff then
            Connections.Staff:Disconnect(); Connections.Staff = nil
        end
    end })

