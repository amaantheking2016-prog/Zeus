MainTab:CreateSlider({ Name="Humanizer Max", Range={1,100}, Increment=1, CurrentValue=85, Flag="Hum_Max",
    Callback = function(v) State.HumanizerMax = v end })

-- ═══ AUTOMATION TAB ═══
AutomationTab:CreateSection("Auto Spam")
AutomationTab:CreateToggle({
    Name = "Auto Spam", CurrentValue = false, Flag = "Auto_Spam",
    Callback = function(on)
        State.AutoSpam = on
        if on then
            if Connections.AutoSpam then Connections.AutoSpam:Disconnect() end
            Connections.AutoSpam = RunService.PostSimulation:Connect(function()
                if not State.AutoSpam then return end
                local char = Player.Character
                if not char or char.Parent ~= Alive then return end
                local ball = getBall()
                if not ball or not ball:FindFirstChild("zoomies") then return end
                local vel = ball:FindFirstChild("zoomies").VectorVelocity
                if vel.Magnitude < 50 then return end
                local dist = (char.PrimaryPart.Position - ballPosition(ball)).Magnitude
                local ping = getPing()
                local thresh = math.clamp(ping / 10, 5, 17) + vel.Magnitude / 5.8
                if State.CooldownProtection then
                    local hb = PlayerGui:FindFirstChild("Hotbar")
                    local blk = hb and hb:FindFirstChild("Block")
                    local gr = blk and blk:FindFirstChildWhichIsA("UIGradient")
                    if gr and gr.Offset.Y < 0.49 then return end
                end
                if dist <= thresh and State.Parries >= State.SpamThreshold then
                    if State.SpamMode == "Keypress" then
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                        task.wait(0.02)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                    else
                        doParry()
                    end
                end
            end)
        elseif Connections.AutoSpam then
            Connections.AutoSpam:Disconnect(); Connections.AutoSpam = nil
        end
    end,
})

AutomationTab:CreateDropdown({ Name="Spam Mode", Options={"Remote","Keypress"}, CurrentOption="Remote", Flag="Spam_Mode",
    Callback = function(v) State.SpamMode = v end })

AutomationTab:CreateSlider({ Name="Spam Threshold", Range={1,3}, Increment=1, CurrentValue=2, Flag="Spam_Threshold",
    Callback = function(v) State.SpamThreshold = v end })

AutomationTab:CreateSection("Manual Spam")
AutomationTab:CreateToggle({
    Name = "Manual Spam", CurrentValue = false, Flag = "Manual_Spam",
    Callback = function(on)
        State.ManualSpam = on
        if on then
            local accum = 0
            if Connections.ManualSpam then Connections.ManualSpam:Disconnect() end
            Connections.ManualSpam = RunService.Heartbeat:Connect(function(dt)
                if not State.ManualSpam then return end
                local char = Player.Character
                if not char or char.Parent ~= Alive then return end
                accum += dt
                local interval = 1 / math.max(1, State.ManualCPS)
                if accum < interval then return end
                accum = 0
                doParry()
            end)
        elseif Connections.ManualSpam then
            Connections.ManualSpam:Disconnect(); Connections.ManualSpam = nil
        end
    end,
})

AutomationTab:CreateSlider({ Name="Manual Spam CPS", Range={60,1000}, Increment=10, Suffix=" CPS", CurrentValue=240, Flag="Manual_CPS",
    Callback = function(v) State.ManualCPS = v end })

AutomationTab:CreateSection("Triggerbot")
AutomationTab:CreateToggle({
    Name = "Triggerbot", CurrentValue = false, Flag = "Triggerbot",
    Callback = function(on)
        State.Triggerbot = on
        if on then
            if Connections.Triggerbot then Connections.Triggerbot:Disconnect() end
            Connections.Triggerbot = RunService.PreSimulation:Connect(function()
                if not State.Triggerbot then return end
                for _, b in ipairs(getBalls()) do
                    if b:GetAttribute("target") ~= Player.Name then continue end
                    local d = getCurveData(b)
                    if d.TriggerbotParried then continue end
                    if os.clock() - State.LastParry < 0.5 then continue end
                    local char = Player.Character
                    if not char or not char.PrimaryPart then continue end
                    if char.PrimaryPart:FindFirstChild("SingularityCape") then continue end
                    playAnimation()
                    doParry()
                    State.LastParry = os.clock()
                    d.TriggerbotParried = true
                    task.delay(1, function() d.TriggerbotParried = false end)
                end
            end)
        elseif Connections.Triggerbot then
            Connections.Triggerbot:Disconnect(); Connections.Triggerbot = nil
        end
    end,
})

