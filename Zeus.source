    Callback = function(v) State.ParryAccuracy = v end })

MainTab:CreateSlider({ Name="Parry Range", Range={0,10}, Increment=1, CurrentValue=0, Flag="Parry_Range",
    Callback = function(v) State.ParryRange = v end })

MainTab:CreateToggle({ Name="Randomize Accuracy", CurrentValue=false, Flag="Humanizer",
    Callback = function(v) State.Humanizer = v end })

MainTab:CreateSlider({ Name="Humanizer Min", Range={1,100}, Increment=1, CurrentValue=25, Flag="Hum_Min",
