-- ═══ STATE ═══
local State = {
    AutoParry = false, ParryType = "Camera", ParryMode = "Remote",
    ParryAccuracy = 100, ParryRange = 0,
    Humanizer = false, HumanizerMin = 25, HumanizerMax = 85,
    AutoSpam = false, SpamThreshold = 2, SpamMode = "Remote",
    ManualSpam = false, ManualCPS = 240,
    Triggerbot = false,
    DetectInfinity = false, DetectDeathSlash = false, DetectTimeHole = false,
    DetectSoF = false, DetectPhantom = false, DetectDribble = false,
    DetectStaff = false,
    InfinityActive = false, DeathSlashActive = false, TimeHoleActive = false, SoFActive = false,
    Speed = false, SpeedValue = 36,
    Fly = false, FlySpeed = 50,
    Spinbot = false, SpinSpeed = 5,
    FollowTarget = nil, FollowNotify = false,
    AvatarChanger = false,
    NoRender = false, AntiLag = false,
    AbilityESP = false, BallTrail = false, BallTrailRainbow = false,
    BallStats = false, FOV = false, FOVValue = 70,
    HitSounds = false, HitSoundType = "Medal", HitSoundVolume = 5,
    PingSpoofer = false, PingValue = 999,
    CustomSky = false, SkySelection = "Default",
    AntiAFK = false, AutoRejoin = false,
    SemiImmortal = false, SemiRadius = 40, SemiHeight = 100,
    AutoAbility = false, CooldownProtection = false,
    SkinChanger = false, SwordModel = "",
    Parried = false, Parries = 0, LastPlayAnim = 0, BypassCd = false, LastParry = 0,
}

local Connections = {}
local BallData = setmetatable({}, { __mode = "k" })
local TrackedBall, RealBallPos

-- ═══ HELPERS ═══
local function getPing()
    local ok2, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok2 and v or (Player:GetNetworkPing() * 1000)
end

local function getBall()
    for _, b in ipairs(Balls:GetChildren()) do
        if b:GetAttribute("realBall") then return b end
    end
end

local function getBalls()
    local t = {}
    for _, b in ipairs(Balls:GetChildren()) do
        if b:GetAttribute("realBall") then table.insert(t, b) end
    end
    return t
end

local function ballPosition(ball)
    if ball == TrackedBall and RealBallPos then return RealBallPos end
    return ball.Position
end

local function getCurveData(ball)
    if BallData[ball] then return BallData[ball] end
    local d = { Flips=0, FlipTime=0, Dot=0, LerpRad=0, LastWarping=0, Curving=0, TriggerbotParried=false }
    BallData[ball] = d
    d.Target = ball:GetAttributeChangedSignal("target"):Connect(function()
        State.Parried = false
        d.TriggerbotParried = false
    end)
    return d
end

local function isCurved(ball)
    if not ball or ball:GetAttribute("target") ~= Player.Name then return false end
    local char = Player.Character
    local root = char and char.PrimaryPart
    if not root then return false end
    local z = ball:FindFirstChild("zoomies")
    if not z then return false end
    local vel = z.VectorVelocity
    local pos = ballPosition(ball)
    local offset = root.Position - pos
    local speed = vel.Magnitude
    local dist = offset.Magnitude
    if speed < 0.001 or dist < 0.001 then return false end
    local d = getCurveData(ball)
    local dir = offset.Unit
    local bdir = vel.Unit
    local dot = dir:Dot(bdir)
    local ping = getPing()
    local dotTh = 0.5 - ping / 1000
    local reachT = math.max(0, dist / speed - ping / 1000)
    local distTh = 15 - math.min(dist / 1000, 15) + 20 * math.max(dot, 0) + math.min(speed / 100, 40)
    local rad = math.rad(math.asin(math.clamp(dot, -1, 1)))
    local t = os.clock()
    if math.sign(dot) ~= math.sign(d.dot) then
        if t - d.FlipTime < 0.2 then d.Flips += 1 else d.Flips = 0 end
        d.FlipTime = t
    end
    d.Dot = dot
    d.LerpRad = d.LerpRad + (rad - d.LerpRad) * 0.8
    if speed > 100 and reachT > ping / 10 then distTh = math.max(distTh - 15, 15) end
    if d.Flips >= 5 then return false end
    if dot < 0 then return true end
    if dist < distTh then return false end
    if dot < dotTh then return true end
    if d.LerpRad < 0.018 then d.LastWarping = tick() end
    if tick() - d.LastWarping < reachT / 1.5 then return true end
    return dot < dotTh
end

local function getHumanizedAccuracy()
    if not State.Humanizer then return State.ParryAccuracy end
    local mn = math.min(State.HumanizerMin, State.HumanizerMax)
    local mx = math.max(State.HumanizerMin, State.HumanizerMax)
    return math.random(mn, mx)
end

-- ═══ PARRY SENDER (simple hook, no fragile native bypass) ═══
local revertedRemotes = {}
local PF = nil

-- Find parry function from Hotbar.Block.Activated
pcall(function()
    local SC
    if ReplicatedStorage:FindFirstChild("Controllers") then
        for _, c in ipairs(ReplicatedStorage.Controllers:GetChildren()) do
            if c.Name:match("^SwordsController") then SC = c break end
        end
    end
    if SC and PlayerGui:FindFirstChild("Hotbar") and PlayerGui.Hotbar:FindFirstChild("Block") then
        for _, v in pairs(getconnections(PlayerGui.Hotbar.Block.Activated)) do
            if v.Function and getfenv(v.Function).script == SC then
                PF = v.Function
                break
            end
        end
    end
end)

local function isValidRemoteArgs(args)
    return #args == 7 and type(args[2]) == "string" and type(args[3]) == "number"
        and typeof(args[4]) == "CFrame" and type(args[5]) == "table"
        and type(args[6]) == "table" and type(args[7]) == "boolean"
end

local function hookRemote(remote)
    if revertedRemotes[remote] then return end
    local meta = getrawmetatable(remote)
    if not meta then return end
    setreadonly(meta, false)
    local oldIndex = meta.__index
    meta.__index = function(self, key)
        if (key == "FireServer" and self:IsA("RemoteEvent")) or
           (key == "InvokeServer" and self:IsA("RemoteFunction")) then
            return function(_, ...)
                local args = {...}
                if isValidRemoteArgs(args) and not revertedRemotes[self] then
                    revertedRemotes[self] = args
                end
                return oldIndex(self, key)(_, unpack(args))
            end
        end
        return oldIndex(self, key)
    end
    setreadonly(meta, true)
end

for _, remote in ipairs(ReplicatedStorage:GetChildren()) do
    if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
        pcall(hookRemote, remote)
    end
end
ReplicatedStorage.ChildAdded:Connect(function(child)
    if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then pcall(hookRemote, child) end
end)

local function sendParry(dir, targets, aim)
    local fired = false
    for remote, origArgs in pairs(revertedRemotes) do
        local modArgs = { origArgs[1], origArgs[2], origArgs[3], dir, targets, aim, origArgs[7] }
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(unpack(modArgs)); fired = true
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(unpack(modArgs)); fired = true
            end
        end)
    end
    if not fired and PF then pcall(PF); fired = true end
    if not fired then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        fired = true
    end
    return fired
end

-- ═══ PARRY DATA ═══
local function buildParryData(parryType)
    local cam = workspace.CurrentCamera
    local mousePos = UserInputService:GetMouseLocation()
    local targets = {}
    for _, m in ipairs(Alive:GetChildren()) do
        if m:FindFirstChild("HumanoidRootPart") then
            pcall(function() targets[m.Name] = cam:WorldToScreenPoint(m.HumanoidRootPart.Position) end)
        end
    end
    local mouse = { mousePos.X, mousePos.Y }
    local camFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + cam.CFrame.LookVector)

    if parryType == "Camera" then return camFrame, targets, mouse end
    if parryType == "Random" then
        local dir = Vector3.new(math.random(-3000,3000), math.random(-3000,3000), math.random(-3000,3000))
        return CFrame.new(cam.CFrame.Position, cam.CFrame.Position + dir), targets, mouse
    end
    if parryType == "Backwards" then
        local l = -cam.CFrame.LookVector * 10000
        return CFrame.new(cam.CFrame.Position, cam.CFrame.Position + Vector3.new(l.X, 100, l.Z)), targets, mouse
    end
    if parryType == "High" then
        return CFrame.new(cam.CFrame.Position, cam.CFrame.Position + Vector3.new(0, 10000, 0)), targets, mouse
    end
    if parryType == "Down" then
        return CFrame.new(cam.CFrame.Position, cam.CFrame.Position + Vector3.new(0, -9e18, 0)), targets, mouse
    end
    if parryType == "Dot" then
        local best, bestDist
        bestDist = math.huge
        local vp = cam.ViewportSize
        local center = Vector2.new(vp.X/2, vp.Y/2)
        for _, m in ipairs(Alive:GetChildren()) do
            if m ~= Player.Character and m.PrimaryPart then
                local sp, on = cam:WorldToScreenPoint(m.PrimaryPart.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < bestDist then bestDist = d; best = { C = m, S = {sp.X, sp.Y} } end
                end
            end
        end
        if best and Player.Character and Player.Character.PrimaryPart then
            return CFrame.new(Player.Character.PrimaryPart.Position, best.C.PrimaryPart.Position), targets, best.S
        end
        return camFrame, targets, mouse
    end
    if parryType == "Closest" then
        local best, bestDist = nil, math.huge
        for _, m in ipairs(Alive:GetChildren()) do
            if m ~= Player.Character and m.PrimaryPart and Player.Character and Player.Character.PrimaryPart then
                local d = (Player.Character.PrimaryPart.Position - m.PrimaryPart.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    local sp, on = cam:WorldToScreenPoint(m.PrimaryPart.Position)
                    if on then best = { C = m, S = {sp.X, sp.Y} } end
                end
            end
        end
        if best then
            return CFrame.new(Player.Character.PrimaryPart.Position, best.C.PrimaryPart.Position), targets, best.S
        end
        return camFrame, targets, mouse
    end
    if parryType == "RandomTarget" then
        local cands = {}
        for _, m in ipairs(Alive:GetChildren()) do
            if m ~= Player.Character and m.PrimaryPart then
                local sp, on = cam:WorldToScreenPoint(m.PrimaryPart.Position)
                if on then table.insert(cands, { C = m, S = {sp.X, sp.Y} }) end
            end
        end
        if #cands > 0 then
            local c = cands[math.random(1, #cands)]
            return CFrame.new(Player.Character.PrimaryPart.Position, c.C.PrimaryPart.Position), targets, c.S
        end
        return camFrame, targets, mouse
    end
    return camFrame, targets, mouse
end

local function doParry(parryType)
    local frame, targets, aim = buildParryData(parryType or State.ParryType)
    local ok2 = sendParry(frame, targets, aim)
    if ok2 then
        State.Parries += 1
        task.delay(0.5, function() if State.Parries > 0 then State.Parries -= 1 end end)
    end
    return ok2
end

-- Animation
local function playParryAnim()
    pcall(function()
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local anim = hum and hum:FindFirstChildOfClass("Animator")
        if not anim then return end
        local attr = char:GetAttribute("CurrentlyEquippedSword") or Player:GetAttribute("CurrentlyEquippedSword")
        if not attr then return end
        local swordApi = require(ReplicatedStorage.Shared.SwordAPI)
        local animCtrl = require(ReplicatedStorage.Controllers.AnimationController)
        local swords = require(ReplicatedStorage.Shared.ReplicatedInstances.Swords)
        local info = swords:GetSword(attr)
        if not info then return end
        for _, t in animCtrl:GetPlayingAnimationTracks(anim) do
            if t.Name == "Parry" or t.Name == "GrabParry" or t.Name == "Grab" then
                t:Stop(t:GetAttribute("StopFadeTime") or 0.1)
            end
        end
        for _, a in swordApi:GetAnimations(char, {"Parry","GrabParry"}, info.AnimationType, info.SwordType) do
            local t = animCtrl:LoadAnimation(anim, a, true)
            t:Play(t:GetAttribute("PlayFadeTime") or 0.1, t:GetAttribute("PlayWeight") or 1, t:GetAttribute("PlaySpeed") or 1)
        end
    end)
end

local function playAnimation()
    if os.clock() - State.LastPlayAnim >= 1 or State.BypassCd then
        State.LastPlayAnim = os.clock()
        State.BypassCd = false
        playParryAnim()
    end
end

-- ═══ MAIN TAB ═══
MainTab:CreateSection("Auto Parry")

MainTab:CreateToggle({
    Name = "Auto Parry",
    CurrentValue = false,
    Flag = "Auto_Parry",
    Callback = function(on)
        State.AutoParry = on
        if on then
            if Connections.AutoParry then Connections.AutoParry:Disconnect() end
            Connections.AutoParry = RunService.PreSimulation:Connect(function()
                if not State.AutoParry then return end
                local char = Player.Character
                if not char or char.Parent ~= Alive or not char.PrimaryPart then return end
                for _, b in ipairs(getBalls()) do
                    if b:GetAttribute("target") ~= Player.Name then continue end
                    local z = b:FindFirstChild("zoomies")
                    if not z then continue end
                    if State.DetectInfinity and State.InfinityActive then continue end
                    if State.DetectDeathSlash and State.DeathSlashActive then continue end
                    if State.DetectTimeHole and State.TimeHoleActive then continue end
                    if State.DetectSoF and State.SoFActive then continue end
                    if b:FindFirstChild("ComboCounter") then continue end
                    if char.PrimaryPart:FindFirstChild("SingularityCape") then continue end
                    if isCurved(b) then continue end
                    local vel = z.VectorVelocity
                    local speed = vel.Magnitude
                    local pos = ballPosition(b)
                    local dist = (char.PrimaryPart.Position - pos).Magnitude
                    local ping = getPing()
                    local acc = getHumanizedAccuracy()
                    local mult = 0.7 + (acc - 1) * (0.35 / 99)
                    local sDiv = (2.4 + math.clamp(speed - 9.5, 0, 650) * 0.002) * mult
                    local thresh = math.clamp(ping / 10, 5, 17) + math.max(speed / sDiv, 9.5) + State.ParryRange
                    if State.CooldownProtection then
                        local hb = PlayerGui:FindFirstChild("Hotbar")
                        local blk = hb and hb:FindFirstChild("Block")
                        local gr = blk and blk:FindFirstChildWhichIsA("UIGradient")
                        if gr and gr.Offset.Y < 0.4 then
                            pcall(function() ReplicatedStorage.Remotes.AbilityButtonPress:Fire() end)
                            continue
                        end
                    end
                    if State.AutoAbility then
                        local hb = PlayerGui:FindFirstChild("Hotbar")
                        local ab = hb and hb:FindFirstChild("Ability")
                        local gr = ab and ab:FindFirstChildWhichIsA("UIGradient")
                        if gr and gr.Offset.Y == 0.5 then
                            local abs = char:FindFirstChild("Abilities")
                            if abs then
                                for _, nm in ipairs({"Raging Deflection","Rapture","Calming Deflection","Aerodynamic Slash","Fracture","Death Slash"}) do
                                    local o = abs:FindFirstChild(nm)
                                    if o and o.Enabled then
                                        pcall(function() ReplicatedStorage.Remotes.AbilityButtonPress:Fire() end)
                                        break
                                    end
                                end
                            end
                        end
                    end
                    if dist <= thresh and not State.Parried then
                        playAnimation()
                        if State.ParryMode == "Keypress" then
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                        else
                            doParry()
                        end
                        State.LastParry = os.clock()
                        State.Parried = true
                        task.delay(0.6, function() State.Parried = false end)
                    end
                end
            end)
        elseif Connections.AutoParry then
            Connections.AutoParry:Disconnect()
            Connections.AutoParry = nil
        end
    end,
})

MainTab:CreateDropdown({
    Name = "Parry Type",
    Options = {"Camera","High","Down","Dot","Closest","Random","RandomTarget","Backwards"},
    CurrentOption = "Camera",
    Flag = "Parry_Type",
