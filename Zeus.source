VisualTab:CreateToggle({ Name="Ability ESP", CurrentValue=false, Flag="AESP",
    Callback = function(v)
        State.AbilityESP = v
        if v then
            local function attach(p)
                pcall(function()
                    if p == Player then return end
                    local c = p.Character
                    if not c then return end
                    local head = c:FindFirstChild("Head")
                    if not head then return end
                    if head:FindFirstChild("ZeusESPGui") then return end
                    local bg = Instance.new("BillboardGui")
                    bg.Name = "ZeusESPGui"; bg.Adornee = head
                    bg.Size = UDim2.new(0,200,0,50)
                    bg.StudsOffset = Vector3.new(0,3.5,0)
                    bg.AlwaysOnTop = true; bg.Parent = head
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.fromScale(1,1)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3 = Color3.fromRGB(255,220,50)
                    lbl.TextStrokeTransparency = 0.5
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 13
                    lbl.Name = "AbilityLabel"
                    lbl.Parent = bg
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if h then h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
                end)
            end
            for _, p in ipairs(Players:GetPlayers()) do attach(p) end
            if Connections.ESPAdded then Connections.ESPAdded:Disconnect() end
            Connections.ESPAdded = Players.PlayerAdded:Connect(function(p)
                p.CharacterAdded:Connect(function() task.wait(0.5); attach(p) end)
            end)
        else
            for _, p in ipairs(Players:GetPlayers()) do
                local head = p.Character and p.Character:FindFirstChild("Head")
                local bg = head and head:FindFirstChild("ZeusESPGui")
                if bg then bg:Destroy() end
            end
        end
    end })

VisualTab:CreateToggle({ Name="Ball Trail", CurrentValue=false, Flag="BT",
    Callback = function(on)
        State.BallTrail = on
        if on then
            if Connections.BT then Connections.BT:Disconnect() end
            local hue = 0
            Connections.BT = RunService.Heartbeat:Connect(function()
                if not State.BallTrail then return end
                local ball = getBall()
                if not ball then return end
                local trail = ball:FindFirstChild("ZeusTrail")
                if not trail then
                    trail = Instance.new("Trail"); trail.Name = "ZeusTrail"
                    local a0 = Instance.new("Attachment"); a0.Position = Vector3.new(0, ball.Size.Y/2, 0); a0.Parent = ball
                    local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, -ball.Size.Y/2, 0); a1.Parent = ball
                    trail.Attachment0 = a0; trail.Attachment1 = a1
                    trail.Lifetime = 0.4; trail.WidthScale = NumberSequence.new(0.5)
                    trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1)})
                    trail.Parent = ball
                end
                if State.BallTrailRainbow then
                    hue = (hue + 1) % 360
                    trail.Color = ColorSequence.new(Color3.fromHSV(hue/360, 1, 1))
                else
                    trail.Color = ColorSequence.new(Color3.fromRGB(0,255,255))
                end
            end)
        else
            if Connections.BT then Connections.BT:Disconnect(); Connections.BT = nil end
            for _, b in ipairs(getBalls()) do local t = b:FindFirstChild("ZeusTrail"); if t then t:Destroy() end end
        end
    end })

VisualTab:CreateToggle({ Name="Rainbow Trail", CurrentValue=false, Flag="BTR",
